#!/bin/sh
# SessionStart hook: until a course is indexed on this machine, tell Claude
# (and the student) that /second-mind:setup is the way in.
HOME_DIR="${SM_HOME:-${CLAUDE_PLUGIN_DATA:-}}"
if [ -n "$HOME_DIR" ] && [ -d "$HOME_DIR/index.lancedb" ]; then
  exit 0
fi
cat <<'JSON'
{"systemMessage": "Second Mind isn't set up yet. Run /second-mind:setup to connect Canvas and index your courses.", "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "Second Mind is installed but not set up on this machine: no course is indexed yet. If the student asks about their courses, deadlines or Canvas, suggest running /second-mind:setup first (list_assignments may already work if a Canvas token is set)."}}
JSON
