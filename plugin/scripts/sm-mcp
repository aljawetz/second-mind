#!/bin/sh
# Starts the Second Mind MCP server (plugin/server, run by uvx). A student
# installs nothing by hand: when this machine has no uv, the official installer
# (pinned) puts it in the plugin's data folder, without touching PATH or shell
# profiles. Everything it prints goes to stderr: stdout is the MCP channel.
#
#   sm-mcp                   the server (what .mcp.json runs)
#   sm-mcp --download-model  get uv, the server's packages and the search model
#   sm-mcp --version         get uv and the server's packages
set -eu

UV_VERSION=0.9.28
# Run from a repo checkout (dev.sh, or a marketplace added from a local path,
# which Claude Code loads in place): that checkout's server. Installed from
# GitHub, the plugin is a copy without the backend: the release tag.
PLUGIN_DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$PLUGIN_DIR/../backend/mcp_server.py" ]; then
  DEFAULT_SOURCE="$PLUGIN_DIR/server"
else
  DEFAULT_SOURCE="git+https://github.com/aljawetz/second-mind@plugin-v0.1.0#subdirectory=plugin/server"
fi
SOURCE="${SM_SERVER_SOURCE:-$DEFAULT_SOURCE}"
DATA="${CLAUDE_PLUGIN_DATA:-$HOME/.second-mind-plugin}"
UV_DIR="$DATA/uv"

find_uvx() {
  for candidate in "$(command -v uvx 2>/dev/null || true)" "$HOME/.local/bin/uvx" "$HOME/.cargo/bin/uvx" "$UV_DIR/uvx"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

if ! UVX="$(find_uvx)"; then
  echo "second-mind: installing uv $UV_VERSION into $UV_DIR" >&2
  mkdir -p "$UV_DIR"
  curl -LsSf "https://astral.sh/uv/$UV_VERSION/install.sh" | env UV_UNMANAGED_INSTALL="$UV_DIR" sh >&2
  UVX="$UV_DIR/uvx"
fi

exec "$UVX" --from "$SOURCE" sm-mcp "$@"
